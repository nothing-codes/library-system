generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Role {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  users        User[]

  @@map("Роли")
}

model User {
  id           Int            @id @default(autoincrement())
  login        String         @unique
  password     String
  roleId       Int
  role         Role           @relation(fields: [roleId], references: [id])
  reader       Reader?

  @@map("Пользователи")
}

model Reader {
  id           Int            @id @default(autoincrement())
  userId       Int?           @unique
  lastName     String
  firstName    String
  middleName   String?
  phone        String?
  className    String?
  openPassword String?
  user         User?          @relation(fields: [userId], references: [id])
  issues       Issue[]

  @@map("Читатели")
}

model Book {
  id           Int            @id @default(autoincrement())
  title        String
  author       String
  year         Int?
  isbn         String?        @unique
  quantity     Int            @default(0)
  issues       Issue[]

  @@map("Книги")
}

model Status {
  id           Int            @id @default(autoincrement())
  name         String
  issues       Issue[]

  @@map("Статус")
}

model Issue {
  id           Int            @id @default(autoincrement())
  bookId       Int
  readerId     Int
  issueDate    String
  dueDate      String?
  returnDate   String?
  loanPeriod   Int            @default(14)
  statusId     Int
  book         Book           @relation(fields: [bookId], references: [id])
  reader       Reader         @relation(fields: [readerId], references: [id])
  status       Status         @relation(fields: [statusId], references: [id])

  @@map("Выдачи")
}
